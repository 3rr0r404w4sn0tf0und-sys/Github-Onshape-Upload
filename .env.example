# Copy this file to .env for local development (git-ignored).
# In production (Render), set these as actual environment variables instead -
# .env is never read there unless you add dotenv loading yourself in a
# non-production entrypoint.

# --- GitHub OAuth App (github.com/settings/developers) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Onshape OAuth application (Onshape Developer Portal) ---
ONSHAPE_OAUTH_CLIENT_ID=
ONSHAPE_OAUTH_CLIENT_SECRET=

# --- Session signing secret - any long random string ---
SESSION_SECRET=

# --- Public URL this app is deployed at, no trailing slash ---
# e.g. https://onshape-github-panel.onrender.com
APP_URL=

# --- Postgres connection string for session storage (Neon, etc.) ---
# Use Neon's POOLED connection string (the one with "-pooler" in the host),
# not the direct one - this app opens a connection per session lookup, and
# the pooled endpoint is built for exactly that. Get it from your Neon
# project dashboard -> Connect. Must include "?sslmode=require".
# e.g. postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Local dev only ---
PORT=3000
